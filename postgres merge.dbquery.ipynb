   "source": [
    "MERGE INTO retail_uc.facts.web_returns AS t\n",
    "USING postgres_catalog.retail.web_returns AS s\n",
    "ON  t.wr_order_number = s.wr_order_number\n",
    "AND t.wr_item_sk      = s.wr_item_sk\n",
    "WHEN MATCHED THEN UPDATE SET *\n",
    "WHEN NOT MATCHED THEN INSERT *;\n"
   ]
  }
